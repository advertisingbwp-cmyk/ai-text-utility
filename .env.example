# AI Provider Configuration (Default: Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: OpenAI-compatible Provider Configuration
# AI_PROVIDER=openai
# EXPLABS_API_KEY=your_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Server Protection & Cost Guardrails
AI_MAX_INPUT_CHARS=10000
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_PER_IP_MINUTE=15
AI_TEMPERATURE=0.7

# Distributed Serverless Rate Limiting (Upstash Redis)
# Highly recommended for multi-instance production deployments on Vercel
# If omitted, gracefully falls back to local in-memory sliding window rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
